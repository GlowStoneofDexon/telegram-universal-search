# From https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Produced by `npm run login` (one time). Keep secret.
TELEGRAM_SESSION=

# Must match MTPROTO_WORKER_SECRET stored in the Lovable app
MTPROTO_WORKER_SECRET=

# Where the bot backend lives (the worker polls this for searches)
BOT_BASE_URL=https://combsearchbot.lovable.app

# Optional: move the local link store somewhere else
# FILES_DB_PATH=/sdcard/comb/files.db
